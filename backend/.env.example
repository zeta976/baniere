PORT=3001
NODE_ENV=development
COURSES_JSON_PATH=../courses.json

# Live "oferta de cursos" API (real-time course availability)
# Set USE_LIVE_API=false to use the local courses.json instead.
USE_LIVE_API=true
COURSE_API_URL=https://ofertadecursos.uniandes.edu.co/api/courses
TERM=202620
# Full catalog cache TTL in ms (used for search/listing). Default 10 min.
COURSES_CACHE_TTL_MS=600000
